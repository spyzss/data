{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qc_acceptance_config.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_version",
    "config_name",
    "execution_profiles",
    "pipeline",
    "modules"
  ],
  "properties": {
    "schema_version": {"const": "qc_acceptance_config_schema.v2"},
    "config_version": {
      "type": "string",
      "pattern": "^qc_acceptance_v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "config_name": {"const": "acceptance_gate"},
    "acceptance_policy": {"$ref": "#/$defs/acceptancePolicy"},
    "supplier_adapters": {"$ref": "#/$defs/supplierAdapters"},
    "execution_profiles": {
      "type": "object",
      "minProperties": 1,
      "required": ["acceptance", "supplier_evaluation"],
      "additionalProperties": {"$ref": "#/$defs/executionProfile"}
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_profile", "modules"],
      "properties": {
        "default_profile": {"type": "string", "minLength": 1},
        "terminal_module": {"type": "string", "minLength": 1},
        "modules": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/moduleConfig"},
      "properties": {
        "supplier_data_audit": {
          "allOf": [
            {"$ref": "#/$defs/moduleConfig"},
            {
              "properties": {
                "parameters": {"$ref": "#/$defs/supplierDataAuditParameters"}
              }
            }
          ]
        },
        "keypoint_temporal": {
          "allOf": [
            {"$ref": "#/$defs/moduleConfig"},
            {
              "properties": {
                "parameters": {"$ref": "#/$defs/temporalDecisionParameters"}
              }
            }
          ]
        }
      },
      "required": [
        "hdf5_text_info",
        "quality_hand",
        "keypoint_presence",
        "keypoint_morphology",
        "keypoint_temporal",
        "video_quality",
        "sam3_containment",
        "semantic_consistency",
        "manual_review",
        "duplicate_check",
        "content_validity",
        "effective_duration"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "config_version": {
            "enum": [
              "qc_acceptance_v2.2.0",
              "qc_acceptance_v2.3.0",
              "qc_acceptance_v2.4.0"
            ]
          }
        },
        "required": ["config_version"]
      },
      "then": {
        "properties": {
          "modules": {"required": ["supplier_data_audit"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "config_version": {"const": "qc_acceptance_v2.4.0"}
        },
        "required": ["config_version"]
      },
      "then": {
        "properties": {
          "modules": {
            "properties": {
              "keypoint_temporal": {
                "properties": {
                  "parameters": {
                    "required": [
                      "temporal_decision_timebase",
                      "temporal_target_hz",
                      "temporal_timestamp_source",
                      "temporal_max_gap_factor"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "supplierAdapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["camera_selection"],
          "properties": {
            "camera_selection": {"$ref": "#/$defs/qyCameraSelection"}
          }
        }
      }
    },
    "qyCameraSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "minimum_hand_coverage",
        "minimum_both_hand_coverage",
        "minimum_valid_joint_ratio",
        "minimum_timeline_match_ratio",
        "tie_tolerance",
        "weights"
      ],
      "properties": {
        "schema_version": {"const": "qy.camera_selection.v1"},
        "minimum_hand_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_both_hand_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_valid_joint_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_timeline_match_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "tie_tolerance": {"type": "number", "minimum": 0, "maximum": 1},
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_hand_coverage",
            "both_hand_coverage",
            "valid_joint_ratio",
            "timeline_match_ratio"
          ],
          "properties": {
            "minimum_hand_coverage": {"type": "number", "minimum": 0},
            "both_hand_coverage": {"type": "number", "minimum": 0},
            "valid_joint_ratio": {"type": "number", "minimum": 0},
            "timeline_match_ratio": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "acceptancePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_survival"],
      "properties": {
        "frame_survival": {"$ref": "#/$defs/frameSurvival"}
      }
    },
    "frameSurvival": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "enabled",
        "min_remaining_frame_ratio",
        "stop_when_below",
        "exclude_severities",
        "skeleton_dependent_modules",
        "terminal_asset_fail_modules"
      ],
      "properties": {
        "version": {"const": "frame_survival_v2"},
        "enabled": {"type": "boolean"},
        "min_remaining_frame_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "stop_when_below": {"type": "boolean"},
        "exclude_severities": {
          "type": "array",
          "items": {"const": "fail"},
          "uniqueItems": true
        },
        "skeleton_dependent_modules": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "terminal_asset_fail_modules": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "executionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fail_action", "runtime_error_action"],
      "properties": {
        "fail_action": {
          "enum": ["stop", "record_and_continue"]
        },
        "runtime_error_action": {
          "enum": ["stop_incomplete", "record_and_continue"]
        }
      }
    },
    "moduleConfig": {
      "type": "object",
      "required": ["enabled", "parameters", "rules"],
      "properties": {
        "enabled": {"type": "boolean"},
        "implementation": {"type": "string", "minLength": 1},
        "execution_kind": {"const": "external"},
        "disabled_reason": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "rules": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/ruleConfig"}
        }
      }
    },
    "temporalDecisionParameters": {
      "type": "object",
      "properties": {
        "temporal_decision_timebase": {
          "enum": ["standardized", "native"]
        },
        "temporal_target_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "temporal_timestamp_source": {
          "enum": ["auto", "timestamps_ns", "frame_index_source_fps"]
        },
        "temporal_max_gap_factor": {
          "type": "number",
          "exclusiveMinimum": 1
        }
      }
    },
    "supplierDataAuditParameters": {
      "type": "object",
      "required": ["suppliers"],
      "properties": {
        "suppliers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/supplierAuditConfig"}
        }
      }
    },
    "supplierAuditConfig": {
      "type": "object",
      "required": ["mapping_status", "mapping"],
      "properties": {
        "mapping_status": {"enum": ["verified", "unverified"]},
        "mapping": {"$ref": "#/$defs/supplierMapping"},
        "max_trajectory_gap_frames": {"type": "integer", "minimum": 1},
        "max_timestamp_gap_factor": {"type": "number", "exclusiveMinimum": 1},
        "max_scaled_intrinsics_relative_error": {
          "type": "number",
          "minimum": 0
        },
        "scaling_mismatch_action": {"enum": ["review", "fail"]}
      }
    },
    "supplierMapping": {
      "type": "object",
      "properties": {
        "frames": {"$ref": "#/$defs/timestampMapping"},
        "aligned": {"$ref": "#/$defs/timestampMapping"},
        "imu": {"$ref": "#/$defs/timestampMapping"},
        "trajectory": {"$ref": "#/$defs/timestampMapping"},
        "meta": {"type": "object"},
        "calibration": {"type": "object"},
        "projection": {"$ref": "#/$defs/drProjectionMapping"}
      }
    },
    "drProjectionMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_name",
        "joints3d_coordinate_frame",
        "joints3d_unit",
        "projection_direction",
        "trajectory_usage",
        "resolution_policy"
      ],
      "properties": {
        "camera_name": {"const": "head"},
        "joints3d_coordinate_frame": {"const": "head_camera"},
        "joints3d_unit": {"const": "meter"},
        "projection_direction": {"const": "direct_camera"},
        "trajectory_usage": {"const": "lineage_only"},
        "resolution_policy": {"enum": ["exact", "scale_intrinsics"]}
      }
    },
    "timestampMapping": {
      "type": "object",
      "properties": {
        "timestamp_column": {"type": "string", "minLength": 1},
        "timestamp_unit": {"enum": ["s", "ms", "us", "ns"]},
        "timestamp_scale_to_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frame_index_column": {"type": "string", "minLength": 1}
      },
      "not": {
        "required": ["timestamp_unit", "timestamp_scale_to_seconds"]
      }
    },
    "ruleConfig": {
      "type": "object",
      "properties": {
        "rule_id": {"type": "string"}
      }
    }
  }
}
