{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset_qc_report.v2.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "asset_id",
    "report_revision",
    "qc_config",
    "execution",
    "pipeline_state",
    "overall_decision",
    "source_files",
    "issues",
    "runtime_errors",
    "manual_review"
  ],
  "properties": {
    "schema_version": {"const": "asset_qc_report.v2"},
    "asset_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "supplier_id": {"type": "string", "minLength": 1},
    "report_revision": {"type": "integer", "minimum": 1},
    "qc_config": {"$ref": "#/$defs/qcConfig"},
    "execution": {"$ref": "#/$defs/execution"},
    "pipeline_state": {"$ref": "#/$defs/pipelineState"},
    "overall_decision": {"enum": ["pass", "fail", null]},
    "source_files": {"type": "object", "additionalProperties": true},
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "runtime_errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/runtimeError"}
    },
    "manual_review": {"$ref": "#/$defs/manualReview"},
    "canonical_binding": {"$ref": "#/$defs/canonicalBinding"},
    "canonical_qc_range": {"$ref": "#/$defs/canonicalQcRange"},
    "source_gate": {"$ref": "#/$defs/sourceGate"},
    "hdf5_text_info": {"type": "object"},
    "quality_hand": {"type": "object"},
    "keypoint_presence": {"type": "object"},
    "keypoint_morphology": {"type": "object"},
    "keypoint_temporal": {"type": "object"},
    "supplier_data_audit": {"type": "object"},
    "video_quality": {"type": "object"},
    "sam3_containment": {"type": "object"},
    "semantic_consistency": {"$ref": "#/$defs/externalStage"},
    "semantic_calibration": {"$ref": "#/$defs/semanticCalibration"},
    "duplicate_check": {"type": "object"},
    "content_validity": {"type": "object"},
    "effective_duration": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pipeline_state": {
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "running",
                  "awaiting_external",
                  "incomplete",
                  "error"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "overall_decision": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "pipeline_state": {
            "properties": {
              "status": {"const": "completed"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "overall_decision": {"enum": ["pass", "fail"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "pipeline_state": {
            "properties": {
              "status": {
                "enum": ["running", "awaiting_external", "incomplete", "error"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "overall_decision": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "pipeline_state": {
            "properties": {
              "status": {"const": "stopped"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "overall_decision": {"const": "fail"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime_errors": {"minItems": 1}
        }
      },
      "then": {
        "properties": {
          "pipeline_state": {
            "properties": {
              "status": {
                "enum": ["running", "awaiting_external", "incomplete", "error"]
              }
            }
          },
          "overall_decision": {"type": "null"}
        }
      }
    },
    {
      "if": {"required": ["source_gate"]},
      "then": {"required": ["batch_id"]}
    },
    {
      "if": {
        "required": ["source_gate"],
        "properties": {
          "source_gate": {
            "required": ["evaluation"],
            "properties": {
              "evaluation": {
                "required": ["status"],
                "properties": {"status": {"enum": ["pass", "fail"]}}
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "required": ["module_states"],
            "properties": {
              "module_states": {
                "required": ["source_gate"],
                "properties": {
                  "source_gate": {
                    "required": ["state"],
                    "properties": {"state": {"const": "completed"}}
                  }
                }
              }
            }
          },
          "runtime_errors": {
            "not": {
              "contains": {
                "required": ["module"],
                "properties": {"module": {"const": "source_gate"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["source_gate"],
        "properties": {
          "source_gate": {
            "required": ["evaluation"],
            "properties": {
              "evaluation": {
                "required": ["status"],
                "properties": {"status": {"const": "runtime_error"}}
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "required": ["module_states"],
            "properties": {
              "module_states": {
                "required": ["source_gate"],
                "properties": {
                  "source_gate": {
                    "required": ["state"],
                    "properties": {"state": {"const": "runtime_error"}}
                  }
                }
              }
            }
          },
          "runtime_errors": {
            "minItems": 1,
            "contains": {
              "required": ["module", "retryable"],
              "properties": {
                "module": {"const": "source_gate"},
                "retryable": {"const": true}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["source_gate"],
        "properties": {
          "source_gate": {
            "properties": {
              "evaluation": {
                "properties": {"status": {"const": "fail"}},
                "required": ["status"]
              }
            },
            "required": ["evaluation"]
          }
        }
      },
      "then": {
        "properties": {
          "pipeline_state": {
            "properties": {"status": {"const": "stopped"}}
          },
          "overall_decision": {"const": "fail"}
        }
      }
    },
    {
      "if": {
        "required": ["source_gate"],
        "properties": {
          "source_gate": {
            "properties": {
              "evaluation": {
                "properties": {"status": {"const": "runtime_error"}},
                "required": ["status"]
              }
            },
            "required": ["evaluation"]
          }
        }
      },
      "then": {
        "properties": {
          "pipeline_state": {
            "properties": {"status": {"const": "error"}}
          },
          "overall_decision": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "qcConfig": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "config_version",
        "config_name",
        "config_path",
        "config_hash"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "qc_acceptance_config_schema.v1",
            "qc_acceptance_config_schema.v2"
          ]
        },
        "config_version": {
          "type": "string",
          "pattern": "^qc_acceptance_v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "config_name": {"type": "string", "minLength": 1},
        "config_path": {"type": "string", "minLength": 1},
        "config_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "acceptance_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_policy_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["profile", "started_at", "updated_at"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "started_at": {"type": ["string", "null"]},
        "updated_at": {"type": ["string", "null"]},
        "module_states": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/moduleState"}
        }
      }
    },
    "moduleState": {
      "type": "object",
      "additionalProperties": true,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": [
            "completed",
            "disabled",
            "skipped",
            "not_implemented",
            "runtime_error",
            "awaiting_external",
            "skipped_due_to_fail",
            "not_run_due_to_acceptance_frame_budget",
            "not_run",
            "input_missing",
            "input_invalid",
            "adapter_missing",
            "blocked"
          ]
        },
        "reason": {"type": "string"}
      }
    },
    "runtimeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "error_type",
        "message",
        "occurred_at",
        "retryable"
      ],
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "error_type": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    },
    "pipelineState": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "last_completed_module",
        "next_module",
        "stop_reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "running",
            "awaiting_external",
            "stopped",
            "completed",
            "incomplete",
            "error"
          ]
        },
        "last_completed_module": {"type": ["string", "null"]},
        "next_module": {"type": ["string", "null"]},
        "stop_reason": {"type": ["string", "null"]}
      }
    },
    "manualReview": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "state",
        "candidate_issue_ids",
        "failures_for_batch_stats_issue_ids"
      ],
      "properties": {
        "required": {"type": ["boolean", "null"]},
        "state": {
          "enum": [
            "not_evaluated",
            "not_required",
            "required",
            "queued",
            "in_progress",
            "completed",
            "skipped_due_to_fail"
          ]
        },
        "candidate_issue_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "failures_for_batch_stats_issue_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "selected_issue_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "selection_policy": {
          "type": "string",
          "enum": ["all_candidates"]
        },
        "reviews": {
          "type": "array",
          "items": {"$ref": "#/$defs/manualReviewRecord"}
        },
        "selected_issue_id": {"type": ["string", "null"]},
        "issue_reviews": {
          "type": "object",
          "additionalProperties": true
        },
        "completed_at": {"type": ["string", "null"]}
      }
    },
    "semanticCalibration": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "state": {
          "enum": [
            "not_started",
            "in_progress",
            "finalizing",
            "completed",
            "skipped_due_to_fail",
            "error"
          ]
        },
        "source_dataset_path": {"type": ["string", "null"]},
        "base_hdf5_sha256": {"type": ["string", "null"]},
        "final_hdf5_sha256": {"type": ["string", "null"]},
        "timeline_edit_count": {"type": "integer", "minimum": 0},
        "subtask_text_edit_count": {"type": "integer", "minimum": 0},
        "pending_edit": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/pendingBoundaryEdit"},
            {"$ref": "#/$defs/pendingTextEdit"}
          ]
        },
        "audit": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "pendingSnapshot": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "internal_id",
        "start_frame",
        "end_frame_exclusive",
        "text_cn",
        "text_en"
      ],
      "properties": {
        "internal_id": {"type": "string", "minLength": 1},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame_exclusive": {"type": "integer", "minimum": 1},
        "text_cn": {"type": "string"},
        "text_en": {"type": "string"}
      }
    },
    "pendingBoundaryEdit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["edit_type", "affected_segment_ids", "before", "after"],
      "properties": {
        "edit_type": {"const": "boundary"},
        "affected_segment_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "before": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/pendingSnapshot"}
        },
        "after": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/pendingSnapshot"}
        }
      }
    },
    "pendingTextEdit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["edit_type", "affected_segment_ids", "before", "after"],
      "properties": {
        "edit_type": {"const": "text"},
        "affected_segment_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "before": {
          "oneOf": [
            {"$ref": "#/$defs/pendingSnapshot"},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {"$ref": "#/$defs/pendingSnapshot"}
            }
          ]
        },
        "after": {
          "oneOf": [
            {"$ref": "#/$defs/pendingSnapshot"},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {"$ref": "#/$defs/pendingSnapshot"}
            }
          ]
        }
      }
    },
    "manualReviewRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "review_id",
        "issue_id",
        "reviewer",
        "reviewed_at",
        "verdict",
        "asset_action",
        "comment",
        "evidence_paths"
      ],
      "properties": {
        "review_id": {"type": "string", "minLength": 1},
        "issue_id": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 1},
        "verdict": {
          "enum": ["accept_issue", "reject_issue", "unable_to_determine"]
        },
        "asset_action": {
          "enum": ["accept", "accept_with_risk", "reject", "return_for_rework"]
        },
        "comment": {"type": "string"},
        "evidence_paths": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "externalStage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "state": {
          "enum": [
            "not_started",
            "in_progress",
            "completed",
            "skipped_due_to_fail",
            "error",
            "awaiting_external"
          ]
        }
      }
    },
    "sourceGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow", "evaluation", "metrics", "evidence", "runtime"],
      "properties": {
        "flow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry_gate", "exit_gate"],
          "properties": {
            "entry_gate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state"],
              "properties": {"state": {"const": "entered"}}
            },
            "result_gate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["verdict", "has_fail", "has_warn"],
              "properties": {
                "verdict": {"enum": ["pass", "fail"]},
                "has_fail": {"type": "boolean"},
                "has_warn": {"const": false}
              }
            },
            "exit_gate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "continue_to_next_module"],
              "properties": {
                "state": {"enum": ["continue", "stop_qc", "stop_incomplete"]},
                "continue_to_next_module": {"type": "boolean"},
                "next_module": {"type": "null"}
              }
            }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "declared_identity", "locator"],
          "properties": {
            "status": {"enum": ["pass", "fail", "runtime_error"]},
            "declared_identity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["asset_id", "batch_id", "supplier_id"],
              "properties": {
                "asset_id": {"type": "string", "minLength": 1},
                "batch_id": {"type": "string", "minLength": 1},
                "supplier_id": {"type": "string", "minLength": 1}
              }
            },
            "locator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_path", "source_root", "source_format", "episode_index"],
              "properties": {
                "source_path": {"type": "string", "minLength": 1},
                "source_root": {"type": "string", "minLength": 1},
                "source_format": {"type": "string", "minLength": 1},
                "episode_index": {"type": ["integer", "null"]}
              }
            },
            "diagnostic": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "field", "message", "retryable"],
              "properties": {
                "code": {"type": "string", "minLength": 1},
                "field": {"type": "string", "minLength": 1},
                "message": {"type": "string", "minLength": 1},
                "retryable": {"type": "boolean"}
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {"status": {"enum": ["fail", "runtime_error"]}},
                "required": ["status"]
              },
              "then": {"required": ["diagnostic"]}
            }
          ]
        },
        "metrics": {"type": "object", "maxProperties": 0},
        "evidence": {"type": "array", "maxItems": 0},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical_config"],
          "properties": {
            "canonical_config": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema_version", "config_version", "config_path", "config_hash"],
              "properties": {
                "schema_version": {"const": "canonical_qc_config_schema.v1"},
                "config_version": {"pattern": "^canonical_qc_v[0-9]+\\.[0-9]+\\.[0-9]+$"},
                "config_path": {"type": "string", "minLength": 1},
                "config_hash": {"pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evaluation": {
                "properties": {"status": {"const": "pass"}},
                "required": ["status"]
              }
            }
          },
          "then": {
            "properties": {
              "flow": {
                "required": ["result_gate"],
                "properties": {
                  "result_gate": {
                    "properties": {
                      "verdict": {"const": "pass"},
                      "has_fail": {"const": false},
                      "has_warn": {"const": false}
                    }
                  },
                  "exit_gate": {
                    "properties": {
                      "state": {"const": "continue"},
                      "continue_to_next_module": {"const": true}
                    }
                  }
                }
              },
              "evaluation": {"not": {"required": ["diagnostic"]}}
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluation": {
                "properties": {"status": {"const": "fail"}},
                "required": ["status"]
              }
            }
          },
          "then": {
            "properties": {
              "flow": {
                "required": ["result_gate"],
                "properties": {
                  "result_gate": {
                    "properties": {
                      "verdict": {"const": "fail"},
                      "has_fail": {"const": true},
                      "has_warn": {"const": false}
                    }
                  },
                  "exit_gate": {
                    "properties": {
                      "state": {"const": "stop_qc"},
                      "continue_to_next_module": {"const": false}
                    }
                  }
                }
              },
              "evaluation": {
                "required": ["diagnostic"],
                "properties": {
                  "diagnostic": {
                    "properties": {"retryable": {"const": false}}
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluation": {
                "properties": {"status": {"const": "runtime_error"}},
                "required": ["status"]
              }
            }
          },
          "then": {
            "properties": {
              "flow": {
                "not": {"required": ["result_gate"]},
                "properties": {
                  "exit_gate": {
                    "properties": {
                      "state": {"const": "stop_incomplete"},
                      "continue_to_next_module": {"const": false}
                    }
                  }
                }
              },
              "evaluation": {
                "required": ["diagnostic"],
                "properties": {
                  "diagnostic": {
                    "properties": {"retryable": {"const": true}}
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluation": {
                "required": ["status"],
                "properties": {
                  "status": {"enum": ["pass", "runtime_error"]}
                }
              }
            }
          },
          "then": {
            "properties": {
              "evaluation": {
                "properties": {
                  "locator": {
                    "oneOf": [
                      {
                        "properties": {
                          "source_format": {"const": "hdf5"},
                          "episode_index": {"type": "null"}
                        }
                      },
                      {
                        "properties": {
                          "source_format": {"const": "lerobot"},
                          "episode_index": {
                            "type": ["integer", "null"],
                            "minimum": 0
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "canonicalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "canonical_revision",
        "semantic_fingerprint",
        "source_fingerprint",
        "qc_report_revision"
      ],
      "properties": {
        "schema_version": {"const": "canonical_publish_binding.v1"},
        "canonical_revision": {"type": "integer", "minimum": 1},
        "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "qc_report_revision": {"type": "integer", "minimum": 1}
      }
    },
    "canonicalQcRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame_exclusive", "interval_semantics"],
      "properties": {
        "start_frame": {"const": 0},
        "end_frame_exclusive": {"type": "integer", "minimum": 1},
        "interval_semantics": {"const": "half_open"}
      }
    },
