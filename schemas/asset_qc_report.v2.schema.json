{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset_qc_report.v2.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "asset_id",
    "report_revision",
    "qc_config",
    "execution",
    "pipeline_state",
    "overall_decision",
    "source_files",
    "issues",
    "runtime_errors",
    "manual_review"
  ],
  "properties": {
    "schema_version": {"const": "asset_qc_report.v2"},
    "asset_id": {"type": "string", "minLength": 1},
    "report_revision": {"type": "integer", "minimum": 1},
    "qc_config": {"$ref": "#/$defs/qcConfig"},
    "execution": {"$ref": "#/$defs/execution"},
    "pipeline_state": {"$ref": "#/$defs/pipelineState"},
    "overall_decision": {"enum": ["pass", "fail", null]},
    "source_files": {"type": "object", "additionalProperties": true},
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "runtime_errors": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "manual_review": {"$ref": "#/$defs/manualReview"},
    "semantic_calibration": {"$ref": "#/$defs/semanticCalibration"},
    "hdf5_text_info": {"type": "object"},
    "quality_hand": {"type": "object"},
    "keypoint_presence": {"type": "object"},
    "keypoint_morphology": {"type": "object"},
    "keypoint_temporal": {"type": "object"},
    "video_quality": {"type": "object"},
    "sam3_containment": {"type": "object"},
    "semantic_consistency": {"type": "object"},
    "duplicate_check": {"type": "object"},
    "content_validity": {"type": "object"},
    "effective_duration": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pipeline_state": {
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "running",
                  "awaiting_external",
                  "incomplete",
                  "error"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "overall_decision": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "pipeline_state": {
            "properties": {
              "status": {"const": "completed"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "overall_decision": {"enum": ["pass", "fail"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "pipeline_state": {
            "properties": {
              "status": {
                "enum": ["running", "awaiting_external", "incomplete", "error"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "overall_decision": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "pipeline_state": {
            "properties": {
              "status": {"const": "stopped"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "overall_decision": {"const": "fail"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime_errors": {"minItems": 1}
        }
      },
      "then": {
        "properties": {
          "pipeline_state": {
            "properties": {
              "status": {
                "enum": ["running", "awaiting_external", "incomplete", "error"]
              }
            }
          },
          "overall_decision": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "qcConfig": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "config_version",
        "config_name",
        "config_path",
        "config_hash"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "qc_acceptance_config_schema.v1",
            "qc_acceptance_config_schema.v2"
          ]
        },
        "config_version": {
          "type": "string",
          "pattern": "^qc_acceptance_v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "config_name": {"type": "string", "minLength": 1},
        "config_path": {"type": "string", "minLength": 1},
        "config_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "acceptance_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_policy_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["profile", "started_at", "updated_at"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "started_at": {"type": ["string", "null"]},
        "updated_at": {"type": ["string", "null"]},
        "module_states": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/moduleState"}
        }
      }
    },
    "moduleState": {
      "type": "object",
      "additionalProperties": true,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": [
            "completed",
            "disabled",
            "skipped",
            "not_implemented",
            "runtime_error",
            "awaiting_external",
            "skipped_due_to_fail",
            "not_run_due_to_acceptance_frame_budget",
            "not_run",
            "input_missing",
            "input_invalid",
            "adapter_missing",
            "blocked"
          ]
        },
        "reason": {"type": "string"}
      }
    },
    "pipelineState": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "last_completed_module",
        "next_module",
        "stop_reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "running",
            "awaiting_external",
            "stopped",
            "completed",
            "incomplete",
            "error"
          ]
        },
        "last_completed_module": {"type": ["string", "null"]},
        "next_module": {"type": ["string", "null"]},
        "stop_reason": {"type": ["string", "null"]}
      }
    },
    "manualReview": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "state",
        "candidate_issue_ids",
        "failures_for_batch_stats_issue_ids"
      ],
      "properties": {
        "required": {"type": ["boolean", "null"]},
        "state": {
          "enum": [
            "not_evaluated",
            "not_required",
            "required",
            "queued",
            "in_progress",
            "completed",
            "skipped_due_to_fail"
          ]
        },
        "candidate_issue_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "failures_for_batch_stats_issue_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "selected_issue_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "selected_issue_id": {"type": ["string", "null"]},
        "issue_reviews": {
          "type": "object",
          "additionalProperties": true
        },
        "completed_at": {"type": ["string", "null"]}
      }
    },
    "semanticCalibration": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "state": {
          "enum": [
            "not_started",
            "in_progress",
            "finalizing",
            "completed",
            "skipped_due_to_fail",
            "error"
          ]
        },
        "source_dataset_path": {"type": ["string", "null"]},
        "base_hdf5_sha256": {"type": ["string", "null"]},
        "final_hdf5_sha256": {"type": ["string", "null"]},
        "timeline_edit_count": {"type": "integer", "minimum": 0},
        "subtask_text_edit_count": {"type": "integer", "minimum": 0},
        "pending_edit": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/pendingBoundaryEdit"},
            {"$ref": "#/$defs/pendingTextEdit"}
          ]
        },
        "audit": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "pendingSnapshot": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "internal_id",
        "start_frame",
        "end_frame_exclusive",
        "text_cn",
        "text_en"
      ],
      "properties": {
        "internal_id": {"type": "string", "minLength": 1},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame_exclusive": {"type": "integer", "minimum": 1},
        "text_cn": {"type": "string"},
        "text_en": {"type": "string"}
      }
    },
    "pendingBoundaryEdit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["edit_type", "affected_segment_ids", "before", "after"],
      "properties": {
        "edit_type": {"const": "boundary"},
        "affected_segment_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "before": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/pendingSnapshot"}
        },
        "after": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/pendingSnapshot"}
        }
      }
    },
    "pendingTextEdit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["edit_type", "affected_segment_ids", "before", "after"],
      "properties": {
        "edit_type": {"const": "text"},
        "affected_segment_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "before": {
          "oneOf": [
            {"$ref": "#/$defs/pendingSnapshot"},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {"$ref": "#/$defs/pendingSnapshot"}
            }
          ]
        },
        "after": {
          "oneOf": [
            {"$ref": "#/$defs/pendingSnapshot"},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {"$ref": "#/$defs/pendingSnapshot"}
            }
          ]
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
